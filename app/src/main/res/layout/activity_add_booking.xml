<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:background="@color/light_blue"
            android:gravity="center|start"
            android:orientation="horizontal">

           <LinearLayout
                android:id="@+id/ivBack"
                android:layout_width="@dimen/_50sdp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_back" />

            </LinearLayout>

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_marginTop="@dimen/_minus2sdp"
                android:fontFamily="@font/plexsans_medium"
                android:text="@string/add_booking"
                android:textColor="@color/black"
                android:textSize="@dimen/_16ssp" />

        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/_16sdp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/selectAddressLayout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_45sdp"
                    android:layout_marginHorizontal="@dimen/_18sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:outlineAmbientShadowColor="@color/light_gray"
                    android:outlineSpotShadowColor="@color/light_gray"
                    android:shadowColor="@color/light_gray"
                    app:cardBackgroundColor="@color/light_gray"
                    app:cardCornerRadius="@dimen/_8sdp"
                    app:cardElevation="@dimen/_6sdp"
                    tools:targetApi="p">

                    <LinearLayout
                        android:id="@+id/selectAddress"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <TextView
                            android:id="@+id/tvSelectedAddress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_marginTop="@dimen/_minus2sdp"
                            android:layout_weight="1"
                            android:fontFamily="@font/plexsans_medium"
                            android:text="@string/select_address"
                            android:textColor="@color/darkest_gray"
                            android:textSize="@dimen/_10ssp" />

                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:layout_gravity="end|center"
                            android:layout_marginEnd="@dimen/_16sdp"
                            android:src="@drawable/ic_rounded_dropdown"
                            app:tint="@color/darkest_gray" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/selectSchoolLayout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_45sdp"
                    android:layout_marginHorizontal="@dimen/_18sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:outlineAmbientShadowColor="@color/light_gray"
                    android:outlineSpotShadowColor="@color/light_gray"
                    android:shadowColor="@color/light_gray"
                    app:cardBackgroundColor="@color/light_gray"
                    app:cardCornerRadius="@dimen/_8sdp"
                    app:cardElevation="@dimen/_6sdp"
                    tools:targetApi="p">

                    <LinearLayout
                        android:id="@+id/selectSchool"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <AutoCompleteTextView
                            android:id="@+id/actvSchool"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:completionThreshold="0"
                            android:dropDownHeight="wrap_content"
                            android:dropDownVerticalOffset="4dp"
                            android:fontFamily="@font/plexsans_medium"
                            android:gravity="center_vertical"
                            android:hint="@string/select_school"
                            android:imeOptions="actionDone"
                            android:inputType="text"
                            android:paddingHorizontal="@dimen/_10sdp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/darkest_gray"
                            android:textSize="@dimen/_10ssp" />

                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:layout_gravity="end|center"
                            android:layout_marginEnd="@dimen/_16sdp"
                            android:src="@drawable/ic_rounded_dropdown"
                            app:tint="@color/darkest_gray" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/selectChildLayout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_45sdp"
                    android:layout_marginHorizontal="@dimen/_18sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:outlineAmbientShadowColor="@color/light_gray"
                    android:outlineSpotShadowColor="@color/light_gray"
                    android:shadowColor="@color/light_gray"
                    app:cardBackgroundColor="@color/light_gray"
                    app:cardCornerRadius="@dimen/_8sdp"
                    app:cardElevation="@dimen/_6sdp"
                    tools:targetApi="p">

                    <LinearLayout
                        android:id="@+id/selectChild"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <TextView
                            android:id="@+id/tvSelectedChild"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_marginTop="@dimen/_minus2sdp"
                            android:layout_weight="1"
                            android:fontFamily="@font/plexsans_medium"
                            android:text="@string/select_child"
                            android:textColor="@color/darkest_gray"
                            android:textSize="@dimen/_10ssp" />

                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:layout_gravity="end|center"
                            android:layout_marginEnd="@dimen/_16sdp"
                            android:src="@drawable/ic_rounded_dropdown"
                            app:tint="@color/darkest_gray" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>


                <androidx.cardview.widget.CardView
                    android:id="@+id/selectTenureLayout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_45sdp"
                    android:layout_marginHorizontal="@dimen/_18sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:outlineAmbientShadowColor="@color/light_gray"
                    android:outlineSpotShadowColor="@color/light_gray"
                    android:shadowColor="@color/light_gray"
                    app:cardBackgroundColor="@color/light_gray"
                    app:cardCornerRadius="@dimen/_8sdp"
                    app:cardElevation="@dimen/_6sdp"
                    tools:targetApi="p">

                    <LinearLayout
                        android:id="@+id/selectTenure"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <TextView
                            android:id="@+id/tvSelectedTenure"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_marginTop="@dimen/_minus2sdp"
                            android:layout_weight="1"
                            android:fontFamily="@font/plexsans_medium"
                            android:text="@string/select_tenure"
                            android:textColor="@color/darkest_gray"
                            android:textSize="@dimen/_10ssp" />

                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:layout_gravity="end|center"
                            android:layout_marginEnd="@dimen/_16sdp"
                            android:src="@drawable/ic_rounded_dropdown"
                            app:tint="@color/darkest_gray" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- ADDRESS 1 -->
                <TextView
                    android:id="@+id/etStartDate"
                    style="@style/field_label"
                    android:layout_marginHorizontal="@dimen/_18sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:hint="@string/start_date"
                    android:maxLines="1"
                    android:textColor="@color/black"
                    android:textColorHint="@color/darkest_gray" />

                <!-- SUBMIT -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cvSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_margin="@dimen/_18sdp"
                    app:cardBackgroundColor="@color/theme"
                    app:cardCornerRadius="@dimen/_8sdp">

                    <TextView
                        android:id="@+id/btnSubmit"
                        style="@style/button_theme"
                        android:text="Add Booking" />

                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>

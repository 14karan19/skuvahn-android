<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- BOTTOM SHEET -->
        <LinearLayout
            android:id="@+id/bottomSheet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_bottom_sheet"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_50sdp"
                android:background="@color/light_blue"
                android:gravity="center|start"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/ivBack"
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_12sdp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_back" />

                </LinearLayout>

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:layout_marginTop="@dimen/_minus2sdp"
                    android:fontFamily="@font/plexsans_medium"
                    android:text="@string/add_address"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_16ssp" />

            </LinearLayout>

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/_8sdp"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- House -->
                    <EditText
                        android:id="@+id/etHouse"
                        style="@style/field_label_c"
                        android:layout_height="@dimen/_34sdp"
                        android:hint="Flat / House no / Floor"
                        android:imeOptions="actionNext"
                        android:maxLines="1"
                        android:textColor="@color/black"
                        android:textColorHint="@color/black" />

                    <!-- House -->
                    <EditText
                        android:id="@+id/etCity"
                        style="@style/field_label_c"
                        android:layout_height="@dimen/_34sdp"
                        android:layout_marginVertical="@dimen/_8sdp"
                        android:hint="City"
                        android:imeOptions="actionNext"
                        android:maxLines="1"
                        android:textColor="@color/black"
                        android:textColorHint="@color/black" />

                    <!-- House -->
                    <EditText
                        android:id="@+id/etState"
                        style="@style/field_label_c"
                        android:layout_height="@dimen/_34sdp"
                        android:hint="State"
                        android:imeOptions="actionNext"
                        android:maxLines="1"
                        android:textColor="@color/black"
                        android:textColorHint="@color/black" />

                    <!-- Landmark -->
                    <EditText
                        android:id="@+id/etLandmark"
                        style="@style/field_label_c"
                        android:layout_height="@dimen/_34sdp"
                        android:layout_marginVertical="@dimen/_8sdp"
                        android:hint="Nearby landmark (optional)"
                        android:imeOptions="actionNext"
                        android:maxLines="1"
                        android:textColor="@color/black"
                        android:textColorHint="@color/black" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_2sdp">

                        <!-- Address -->
                        <TextView
                            android:id="@+id/tvAddress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/plexsans_regular"
                            android:text="Fetching location..."
                            android:textColor="#555" />

                        <TextView
                            android:id="@+id/btnPickupLocation"
                            style="@style/button_theme"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textColor="@color/theme"
                            android:text="Pickup Location"
                            android:textSize="@dimen/_9ssp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_12sdp"
                        android:orientation="vertical">

                        <!-- Tags -->
                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipHome"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Home" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipWork"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/_4sdp"
                                android:text="Work" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipOther"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Other" />
                        </com.google.android.material.chip.ChipGroup>

                        <EditText
                            android:id="@+id/etOtherTag"
                            style="@style/field_label_c"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_34sdp"
                            android:hint="Enter address tag (e.g. Gym, Friend's Home)"
                            android:maxLines="1"
                            android:textColor="@color/black"
                            android:textColorHint="@color/black"
                            android:visibility="gone" />

                    </LinearLayout>

                    <!-- SAVE BUTTON -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvSave"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_36sdp"
                        android:layout_marginBottom="@dimen/_24sdp"
                        app:cardBackgroundColor="@color/theme"
                        app:cardCornerRadius="@dimen/_6sdp"
                        app:cardElevation="2dp">

                        <TextView
                            android:id="@+id/btnSave"
                            style="@style/button_theme"
                            android:layout_height="@dimen/_36sdp"
                            android:gravity="center"
                            android:text="Save Address"
                            android:textSize="@dimen/_12ssp"
                            android:textStyle="bold" />

                    </androidx.cardview.widget.CardView>

                    <!-- MAP -->
                    <fragment
                        android:id="@+id/map"
                        android:name="com.google.android.gms.maps.SupportMapFragment"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="invisible" />

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>